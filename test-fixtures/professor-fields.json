      { "value": "<b>Ana</b>", "code": "INVALID_CHARACTERS" },
      { "value": "Ana; DROP TABLE professors", "code": "INVALID_CHARACTERS" },
      { "value": "Ana_María", "code": "INVALID_CHARACTERS" },
      { "value": { "raw": 5 }, "code": "INVALID_FORMAT" }
    ]
  },
  "lastName": {
