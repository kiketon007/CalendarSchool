      "García-López",
      "D'Angelo Müller",
      "O’Neil",
      "Joan·Pau",
      "Ñandú",
      "  Ana  ",
      "Ana   María",
      "A",
      { "repeat": "a", "times": 100 }
    ],
    "invalid": [
