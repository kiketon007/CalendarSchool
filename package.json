{
  "name": "calendarschool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "allowScripts": {
    "cypress@16.1.1": true,
    "esbuild": false,
    "@prisma/engines@7.10.0": true,
    "prisma": false
  },
  "scripts": {
    "db:migrate": "npm run db:migrate -w backend",
    "lint": "npm run lint --workspaces && prettier --check backend frontend",
    "format": "prettier --write backend frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
