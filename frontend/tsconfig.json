{
  // Aplicación y tests de Vitest. Cypress tiene su propio tsconfig en cypress/ y se excluye aquí
  // para que sus tipos globales (describe, it, expect) no choquen con los de Vitest.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Para importar `./src/security/contentSecurityPolicy.ts` con su extensión desde vite.config.ts:
    // el cargador nativo de Vite (futuro predeterminado) no resuelve imports sin ella. Solo es
    // válido con `noEmit`.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "cypress.config.ts"],
  "exclude": ["cypress", "dist", "node_modules"]
}
