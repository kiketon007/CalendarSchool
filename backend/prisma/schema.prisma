// Esquema Prisma de CalendarSchool. Se construye de forma incremental: cada historia
// añade aquí sus modelos (US01_b: municipios, colegios y usuarios; US01_c: refresh tokens; US01_d: intentos del limitador;
// US02_b3: enlaces de acceso; US-BASE: calendarios) y actualiza docs/Modelo_de_Datos/MODELO_DATOS.md.
// La URL de conexión no va aquí: la define prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/prisma/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Para qué sirve un enlace de acceso: invitar a una persona al colegio o restablecer una contraseña.
enum AccessLinkPurpose {
  INVITATION
  PASSWORD_RESET
}

/// Tipo de un periodo de la jornada (US-BASE): una sesión lectiva o un recreo.
enum CalendarPeriodKind {
  SESSION
  BREAK
}

/// Tipo de una regla de reparto de una asignatura en un curso (US19_b). Esta historia solo escribe
/// `MAX_PER_DAY` y `BLOCK`; los tipos de franjas los usarán US19_c y US19_d.
enum ConstraintType {
  MAX_PER_DAY
  BLOCK
  FORBIDDEN_SLOTS
  PREFERRED_SLOTS
}

/// Tipo de una asignatura (US-SUBJECT): troncal, optativa o propia del centro.
enum SubjectType {
  CORE
  ELECTIVE
  CUSTOM
}

/// Estado de una asignatura (US-SUBJECT). Por ahora solo se guarda y se filtra: sus consecuencias (no
/// ofrecerla al asignar profesores ni al generar horarios) llegan con esas historias.
enum SubjectStatus {
  ACTIVE
  INACTIVE
}

/// Color de una asignatura en el horario (US-SUBJECT): una paleta cerrada de 12 claves. El aspecto de cada
/// clave (fondo y texto, con contraste AA) vive en el frontend. Ampliar la paleta exige una migración.
enum SubjectColor {
  blue
  indigo
  purple
  pink
  red
  orange
  yellow
  green
  teal
  cyan
  brown
  gray
}

/// Cargo de un profesor (US09). Es informativo y no concede permisos en la aplicación.
/// Estado de un horario: el borrador que genera US-ALGO-RUN o el oficial que confirma US-ALGO-CONFIRM.
enum ScheduleStatus {
  DRAFT
  OFFICIAL
}

/// Motor que encontró un horario: la búsqueda con retroceso en TypeScript o CP-SAT de OR-Tools (US-ALGO-ORTOOLS).
enum ScheduleEngine {
  BACKTRACKING
  ORTOOLS
}

/// Ciclo de vida de una generación (US-ALGO-RUN).
enum GenerationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// En qué fase está una generación (US-ALGO-RUN_b): busca un horario válido o lo mejora con las preferencias.
enum GenerationPhase {
  SEARCHING
  IMPROVING
}

/// Por qué falló una generación.
enum GenerationErrorCode {
  NOT_READY
  INFEASIBLE
  TIMEOUT
  INTERNAL
}

enum ProfessorPosition {
  DIRECTOR
  JEFE_ESTUDIOS
}

/// Municipios de la Comunitat Valenciana (relación oficial del INE). Datos fijos cargados por migración.
model Municipality {
  /// Código INE: 2 dígitos de provincia y 3 de municipio.
  code     String   @id @db.Char(5)
  /// Nombre oficial, que puede tener dos formas (p. ej. "Alicante/Alacant").
  name     String   @db.VarChar(100)
  province String   @db.VarChar(30)
  schools  School[]

  @@index([name])
  @@map("municipalities")
}

/// Colegios. Cada colegio aísla sus datos de los de los demás.
model School {
  /// UUIDv7 generado por la aplicación.
  id                        String                    @id @db.Uuid
  /// Nombre tal como lo escribe el usuario.
  name                      String                    @db.VarChar(150)
  /// Nombre en minúsculas, sin acentos y solo con letras y dígitos; sirve para la unicidad.
  normalizedName            String                    @map("normalized_name") @db.VarChar(150)
  municipalityCode          String                    @map("municipality_code") @db.Char(5)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()
  municipality              Municipality              @relation(fields: [municipalityCode], references: [code])
  users                     User[]
  accessLinks               AccessLink[]
  courses                   Course[]
  professors                Professor[]
  students                  Student[]
  calendars                 Calendar[]
  subjects                  Subject[]
  schedulingConstraints     SchedulingConstraint[]
  professorUnavailabilities ProfessorUnavailability[]
  professorAssignments      ProfessorAssignment[]
  schedules                 Schedule[]
  scheduleGenerations       ScheduleGeneration[]

  @@unique([normalizedName, municipalityCode])
  @@map("schools")
}

/// Usuarios con cuenta. Cada usuario pertenece a un único colegio.
model User {
  /// UUIDv7 generado por la aplicación.
  id                      String               @id @db.Uuid
  schoolId                String               @map("school_id") @db.Uuid
  /// Email normalizado (sin espacios y en minúsculas), único en todo el sistema.
  email                   String               @unique @db.VarChar(320)
  /// Hash Bcrypt (cost 12).
  passwordHash            String               @map("password_hash") @db.VarChar(60)
  firstName               String               @map("first_name") @db.VarChar(100)
  lastName                String               @map("last_name") @db.VarChar(100)
  role                    UserRole
  status                  UserStatus           @default(ACTIVE)
  /// Instante en que se aceptó la política de privacidad. Va con `privacyPolicyVersion`: las dos o ninguna (CHECK en la migración).
  privacyPolicyAcceptedAt DateTime?            @map("privacy_policy_accepted_at") @db.Timestamptz()
  /// Versión (AAAA-MM-DD) de la política aceptada.
  privacyPolicyVersion    String?              @map("privacy_policy_version") @db.VarChar(20)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  school                  School               @relation(fields: [schoolId], references: [id])
  refreshTokens           RefreshToken[]
  /// Enlaces de acceso que afectan a este usuario (restablecimientos de contraseña).
  accessLinks             AccessLink[]         @relation("AccessLinkUser")
  /// Enlaces de acceso que este usuario generó.
  createdAccessLinks      AccessLink[]         @relation("AccessLinkCreator")
  /// Horarios y generaciones que este usuario inició (US-ALGO-RUN).
  createdSchedules        Schedule[]           @relation("ScheduleCreatedBy")
  /// Horarios que este usuario confirmó como oficiales (US-ALGO-CONFIRM).
  confirmedSchedules      Schedule[]           @relation("ScheduleConfirmedBy")
  createdGenerations      ScheduleGeneration[]

  @@index([schoolId])
  @@map("users")
}

/// Refresh tokens de las sesiones. Solo se guarda el hash del token, nunca el token en claro.
/// Sesión de un usuario. No guarda la IP ni el user agent del cliente: ninguna funcionalidad los usa y
/// solo quedan en los logs de actividad (30 días).
model RefreshToken {
  /// UUIDv7 generado por la aplicación.
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 del token en hexadecimal.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Creación + 24 horas. La sesión no se renueva: es una caducidad absoluta.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  /// Instante de la revocación (cierre de sesión, US03); nulo mientras el token es válido.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Intentos de operaciones limitadas (registro, y más adelante login e invitaciones). Una fila por intento
/// aceptado: el limitador cuenta las de una clave dentro de la ventana y borra las caducadas.
model RateLimitAttempt {
  /// UUIDv7 generado por la aplicación.
  id          String   @id @db.Uuid
  /// `<operación>:<ip>`, p. ej. `register:203.0.113.7`.
  key         String   @db.VarChar(200)
  attemptedAt DateTime @map("attempted_at") @db.Timestamptz()

  @@index([key, attemptedAt])
  @@map("rate_limit_attempts")
}

/// Enlaces de acceso de un solo uso que genera un administrador: invitaciones (US02_b) y restablecimientos
/// de contraseña (US02_c). Solo se guarda el hash del token; el enlace completo se muestra una vez.
/// Un `CHECK` (`access_links_purpose_fields_check`: `role` solo en invitaciones y `user_id` solo en
/// restablecimientos) y el índice único parcial `access_links_pending_reset_user_key` (un solo
/// restablecimiento pendiente por usuario) están escritos a mano en la migración: Prisma no los modela.
model AccessLink {
  /// UUIDv7 generado por la aplicación.
  id          String            @id @db.Uuid
  schoolId    String            @map("school_id") @db.Uuid
  purpose     AccessLinkPurpose
  /// SHA-256 del token en hexadecimal. Nunca el token.
  tokenHash   String            @unique @map("token_hash") @db.Char(64)
  /// Rol del invitado. Obligatorio en las invitaciones y nulo en los restablecimientos.
  role        UserRole?
  /// Usuario afectado. Obligatorio en los restablecimientos y nulo en las invitaciones.
  userId      String?           @map("user_id") @db.Uuid
  /// Administrador que generó el enlace.
  createdById String            @map("created_by_id") @db.Uuid
  /// Creación + 72 horas.
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz()
  usedAt      DateTime?         @map("used_at") @db.Timestamptz()
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz()
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  school      School            @relation(fields: [schoolId], references: [id])
  user        User?             @relation("AccessLinkUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("AccessLinkCreator", fields: [createdById], references: [id])

  @@index([schoolId, purpose])
  @@map("access_links")
}

/// Cursos de un colegio (US05). Su nombre es único en el colegio sin distinguir mayúsculas ni espacios.
model Course {
  /// UUIDv7 generado por la aplicación.
  id             String          @id @db.Uuid
  schoolId       String          @map("school_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name           String          @db.VarChar(100)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad.
  normalizedName String          @map("normalized_name") @db.VarChar(100)
  /// Calendario base que sigue el curso (US-BASE), como mucho uno; si se borra el calendario queda nulo.
  calendarId     String?         @map("calendar_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  school         School          @relation(fields: [schoolId], references: [id])
  calendar       Calendar?       @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  classes        SchoolClass[]
  students       Student[]
  /// Asignaturas que se imparten en este curso; se borran con él (la asignatura sigue existiendo).
  subjects       SubjectCourse[]

  @@unique([schoolId, normalizedName])
  @@index([calendarId])
  @@map("courses")
}

/// Profesores de un colegio (US09). Un registro del colegio, no una cuenta. Las asignaturas llegan con
/// `US-PROF-ASSIGN`; el nombre no es único: puede haber varios profesores con el mismo.
model Professor {
  /// UUIDv7 generado por la aplicación.
  id               String                    @id @db.Uuid
  schoolId         String                    @map("school_id") @db.Uuid
  firstName        String                    @map("first_name") @db.VarChar(100)
  lastName         String                    @map("last_name") @db.VarChar(100)
  position         ProfessorPosition?
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()
  school           School                    @relation(fields: [schoolId], references: [id])
  /// La clase que tutoriza, si tutoriza alguna (como mucho una: `classes.tutor_id` es único).
  tutoredClass     SchoolClass?
  /// Los tramos en los que no está disponible (US-PROF-AVAIL); sin tramos está disponible siempre.
  unavailabilities ProfessorUnavailability[]
  /// Lo que imparte (US-PROF-ASSIGN): una fila por asignatura y clase.
  assignments      ProfessorAssignment[]
  /// Sus sesiones en los horarios generados (US-ALGO-RUN); al borrarlo, la entrada queda sin profesor.
  scheduleEntries  ScheduleEntry[]

  @@index([schoolId])
  @@map("professors")
}

/// Clases (grupos A, B…) de un curso. Se borran con su curso. Su tutor es opcional y, si lo borran, la
/// clase se queda sin tutor (`ON DELETE SET NULL`); un profesor tutoriza como mucho una clase (US09).
model SchoolClass {
  /// UUIDv7 generado por la aplicación.
  id             String     @id @db.Uuid
  courseId       String     @map("course_id") @db.Uuid
  /// Profesor que tutoriza la clase; único: un profesor tutoriza como mucho una clase.
  tutorId        String?    @unique @map("tutor_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name           String     @db.VarChar(10)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad en el curso.
  normalizedName String     @map("normalized_name") @db.VarChar(10)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor          Professor? @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  students       Student[]

  /// Profesores que imparten asignaturas en esta clase (US-PROF-ASSIGN).
  assignments ProfessorAssignment[]

  /// Sus sesiones en los horarios generados (US-ALGO-RUN); caen con la clase.
  scheduleEntries ScheduleEntry[]

  @@unique([courseId, normalizedName])
  /// Lo necesita la clave ajena compuesta de `professor_assignments`: garantiza que la clase es del curso.
  @@unique([id, courseId])
  @@map("classes")
}

/// Alumnos de un colegio (US14). El curso es obligatorio al crear, pero si se borra el curso el alumno
/// sigue existiendo sin curso ni clase (`ON DELETE SET NULL`); quitar solo la clase lo deja en su curso.
/// `food_type` y `observations` son datos sensibles (posibles datos de salud): nunca van a logs ni al
/// listado. Dos `CHECK` escritos a mano en la migración: sin comedor no hay beca ni tipo de comida, y con
/// comedor la beca siempre tiene respuesta. Revisa el SQL de cada `prisma migrate dev` posterior.
model Student {
  /// UUIDv7 generado por la aplicación.
  id           String       @id @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  courseId     String?      @map("course_id") @db.Uuid
  classId      String?      @map("class_id") @db.Uuid
  firstName    String       @map("first_name") @db.VarChar(100)
  lastName     String       @map("last_name") @db.VarChar(100)
  /// Si come en el comedor.
  cafeteria    Boolean
  /// Beca de comedor: nulo si no come en el comedor.
  scholarship  Boolean?
  /// Tipo de comida (dato sensible): nulo si no come en el comedor o no se indicó.
  foodType     String?      @map("food_type") @db.VarChar(255)
  /// Observaciones (dato sensible), hasta 5000 caracteres que limita la aplicación.
  observations String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  school       School       @relation(fields: [schoolId], references: [id])
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  schoolClass  SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([courseId])
  @@index([classId])
  @@map("students")
}

/// Calendarios base del horario de un colegio (US-BASE): una estructura de jornada (p. ej. «Primaria» o
/// «Infantil») igual de lunes a viernes. Su nombre es único en el colegio sin distinguir mayúsculas ni espacios.
model Calendar {
  /// UUIDv7 generado por la aplicación.
  id             String           @id @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name           String           @db.VarChar(100)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad.
  normalizedName String           @map("normalized_name") @db.VarChar(100)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  school         School           @relation(fields: [schoolId], references: [id])
  periods        CalendarPeriod[]
  /// Cursos que siguen este calendario.
  courses        Course[]

  @@unique([schoolId, normalizedName])
  @@map("calendars")
}

/// Un periodo de la jornada de un calendario (US-BASE): una sesión o un recreo. El orden del día es
/// `position`; el número de una sesión no se guarda: es su orden entre las sesiones. Las horas son minutos
/// desde las 00:00 (evita las zonas horarias de `TIME` con Prisma). Un `CHECK` escrito a mano en la migración
/// exige `0 <= start_minute < end_minute <= 1439`: revisa el SQL de cada `prisma migrate dev` posterior.
model CalendarPeriod {
  /// UUIDv7 generado por la aplicación.
  id          String             @id @db.Uuid
  calendarId  String             @map("calendar_id") @db.Uuid
  position    Int                @db.SmallInt
  kind        CalendarPeriodKind
  startMinute Int                @map("start_minute") @db.SmallInt
  endMinute   Int                @map("end_minute") @db.SmallInt
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  calendar    Calendar           @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, position])
  @@map("calendar_periods")
}

/// Asignaturas de un colegio (US-SUBJECT). El nombre es único en el colegio sin distinguir mayúsculas ni
/// espacios; el código, opcional, también (sin distinguir mayúsculas). PostgreSQL trata los `NULL` como
/// distintos en un índice único, así que varias asignaturas sin código no chocan. El color es la clave de
/// una paleta cerrada y puede repetirse entre asignaturas.
model Subject {
  /// UUIDv7 generado por la aplicación.
  id              String          @id @db.Uuid
  schoolId        String          @map("school_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name            String          @db.VarChar(100)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad.
  normalizedName  String          @map("normalized_name") @db.VarChar(100)
  /// Código corto tal como se escribió, o nulo si no tiene (nunca una cadena vacía).
  code            String?         @db.VarChar(10)
  /// Código en minúsculas; sirve para la unicidad. Nulo cuando `code` es nulo.
  normalizedCode  String?         @map("normalized_code") @db.VarChar(10)
  type            SubjectType
  status          SubjectStatus
  /// Descripción opcional (hasta 500 caracteres); nula si está vacía.
  description     String?         @db.VarChar(500)
  color           SubjectColor
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  school          School          @relation(fields: [schoolId], references: [id])
  /// Cursos en los que se imparte. Puede quedar vacía si se borran todos sus cursos.
  courses         SubjectCourse[]
  /// Sus sesiones en los horarios generados (US-ALGO-RUN); caen con la asignatura.
  scheduleEntries ScheduleEntry[]

  @@unique([schoolId, normalizedName])
  @@unique([schoolId, normalizedCode])
  @@map("subjects")
}

/// Curso en el que se imparte una asignatura y sesiones semanales que lleva en él (US-SUBJECT). La clave
/// primaria es la pareja. Se borra con la asignatura y con el curso. Sus reglas de reparto cuelgan de la
/// pareja con una clave ajena compuesta en cascada: por eso la edición de asignaturas aplica diferencias en
/// lugar de reemplazar las filas, o borraría las reglas en cada guardado. Un `CHECK` escrito a mano en la migración exige `sessions_per_week` de 1 a 5:
/// revisa el SQL de cada `prisma migrate dev` posterior.
model SubjectCourse {
  subjectId       String                 @map("subject_id") @db.Uuid
  courseId        String                 @map("course_id") @db.Uuid
  sessionsPerWeek Int                    @map("sessions_per_week") @db.SmallInt
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz()
  subject         Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  constraints     SchedulingConstraint[]
  /// Quién imparte la asignatura en cada clase del curso (US-PROF-ASSIGN).
  assignments     ProfessorAssignment[]

  @@id([subjectId, courseId])
  @@index([courseId])
  @@map("subject_courses")
}

/// Regla de reparto de una asignatura en un curso (US19_b): una fila por (asignatura, curso, tipo). Cuelga de
/// la pareja de `subject_courses` con una clave ajena compuesta en cascada: dejar de impartir la asignatura
/// en el curso, borrar la asignatura o borrar el curso borra sus reglas. `max_per_day` (2 a 5) solo vale
/// en `MAX_PER_DAY` y `block_size` (2 o 3) solo en `BLOCK`. Tres `CHECK` escritos a mano en la migración
/// (`scheduling_constraints_max_per_day_check`, `_block_check` y `_slots_check`) lo exigen: revisa el SQL
/// de cada `prisma migrate dev` posterior.
model SchedulingConstraint {
  id            String                     @id @db.Uuid
  schoolId      String                     @map("school_id") @db.Uuid
  subjectId     String                     @map("subject_id") @db.Uuid
  courseId      String                     @map("course_id") @db.Uuid
  type          ConstraintType
  /// Sesiones sueltas máximas al día (2 a 5); solo en `MAX_PER_DAY`.
  maxPerDay     Int?                       @map("max_per_day") @db.SmallInt
  /// Tamaño del bloque de sesiones seguidas (2 o 3); solo en `BLOCK`.
  blockSize     Int?                       @map("block_size") @db.SmallInt
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()
  school        School                     @relation(fields: [schoolId], references: [id])
  subjectCourse SubjectCourse              @relation(fields: [subjectId, courseId], references: [subjectId, courseId], onDelete: Cascade)
  /// Celdas de las reglas de franjas (`FORBIDDEN_SLOTS`; US19_d añadirá `PREFERRED_SLOTS`); vacía en el resto.
  slots         SchedulingConstraintSlot[]

  @@unique([subjectId, courseId, type])
  @@index([courseId])
  @@index([schoolId])
  @@map("scheduling_constraints")
}

/// Celda de una regla de franjas (US19_c): un día de la semana y el número de una sesión. `session_number` es el
/// orden de la sesión entre las sesiones de la jornada del calendario del curso, no su hora: si el calendario
/// cambia, las celdas que ya no existen se ignoran al leer y se quitan al guardar. Una regla `FORBIDDEN_SLOTS`
/// existe mientras tenga alguna celda, y la aplicación es quien lo garantiza. Cae con su regla (y con ella, con
/// la pareja asignatura-curso, la asignatura y el curso). Dos `CHECK` escritos a mano en la migración
/// (`scheduling_constraint_slots_day_of_week_check`, de 1 a 5, y `_session_number_check`, de 1 a 8, el máximo de
/// sesiones de un calendario en US-BASE) lo exigen: revisa el SQL de cada `prisma migrate dev` posterior.
model SchedulingConstraintSlot {
  constraintId  String               @map("constraint_id") @db.Uuid
  dayOfWeek     Int                  @map("day_of_week") @db.SmallInt
  sessionNumber Int                  @map("session_number") @db.SmallInt
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  constraint    SchedulingConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)

  @@id([constraintId, dayOfWeek, sessionNumber])
  @@map("scheduling_constraint_slots")
}

/// Un tramo en el que un profesor no está disponible (US-PROF-AVAIL): el día y las horas en minutos desde las 00:00,
/// sin depender de ningún calendario. Los tramos de un profesor están normalizados (no se solapan ni se tocan).
model ProfessorUnavailability {
  /// UUIDv7 generado por la aplicación.
  id          String    @id @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  professorId String    @map("professor_id") @db.Uuid
  /// De 1 (lunes) a 5 (viernes).
  dayOfWeek   Int       @map("day_of_week") @db.SmallInt
  /// Minutos desde las 00:00; el tramo es `[startMinute, endMinute)`.
  startMinute Int       @map("start_minute") @db.SmallInt
  endMinute   Int       @map("end_minute") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  school      School    @relation(fields: [schoolId], references: [id])
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([professorId])
  @@map("professor_unavailabilities")
}

/// Qué profesor imparte una asignatura en una clase (US-PROF-ASSIGN): un profesor por asignatura y clase. Las
/// sesiones no se repiten aquí: son las de `subject_courses`. Las dos claves ajenas compuestas llevan el curso, así
/// que la clase es del mismo curso en el que se imparte la asignatura; y todas caen en cascada.
model ProfessorAssignment {
  /// UUIDv7 generado por la aplicación.
  id            String        @id @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  professorId   String        @map("professor_id") @db.Uuid
  subjectId     String        @map("subject_id") @db.Uuid
  courseId      String        @map("course_id") @db.Uuid
  classId       String        @map("class_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  school        School        @relation(fields: [schoolId], references: [id])
  professor     Professor     @relation(fields: [professorId], references: [id], onDelete: Cascade)
  subjectCourse SubjectCourse @relation(fields: [subjectId, courseId], references: [subjectId, courseId], onDelete: Cascade)
  schoolClass   SchoolClass   @relation(fields: [classId, courseId], references: [id, courseId], onDelete: Cascade)

  @@unique([subjectId, classId])
  @@index([professorId])
  @@index([courseId])
  @@map("professor_assignments")
}

/// Un horario generado de un colegio (US-ALGO-RUN). Solo puede haber un borrador por colegio (índice único parcial
/// `schedules_draft_key` sobre `school_id` donde `status = 'DRAFT'`, escrito a mano en la migración, porque Prisma no
/// expresa los índices parciales): una generación nueva sustituye al borrador anterior. Confirmar un borrador
/// (US-ALGO-CONFIRM) lo pasa a `OFFICIAL` con `confirmed_at` y `confirmed_by_id`; el oficial **vigente** es el que no
/// tiene `replaced_at` y solo puede haber uno por colegio (`schedules_official_key`, también a mano); al confirmar otro,
/// el anterior recibe `replaced_at` y se conserva. Los `CHECK` escritos a mano son `schedules_placed_sessions_check`
/// (`placed_sessions` >= 0), `schedules_draft_unconfirmed_check` (un borrador no lleva confirmación),
/// `schedules_official_confirmed_check` (un oficial sí) y `schedules_replaced_after_confirmed_check`.
model Schedule {
  /// UUIDv7 generado por la aplicación.
  id             String               @id @db.Uuid
  schoolId       String               @map("school_id") @db.Uuid
  status         ScheduleStatus
  engine         ScheduleEngine
  /// Sesiones colocadas: una entrada por sesión.
  placedSessions Int                  @map("placed_sessions")
  generatedAt    DateTime             @default(now()) @map("generated_at") @db.Timestamptz()
  createdById    String               @map("created_by_id") @db.Uuid
  /// Cuándo se confirmó como oficial; nulo en un borrador.
  confirmedAt    DateTime?            @map("confirmed_at") @db.Timestamptz()
  /// Quién lo confirmó; nulo en un borrador.
  confirmedById  String?              @map("confirmed_by_id") @db.Uuid
  /// Cuándo dejó de ser el oficial vigente; nulo en un borrador y en el oficial vigente.
  replacedAt     DateTime?            @map("replaced_at") @db.Timestamptz()
  /// Puntuación del horario al generarlo (US-ALGO-RUN_b): `total`, `preferredMisses`, `preferredTotal`,
  /// `professorGaps`, `consecutiveDays` e `initialTotal`, seis enteros. Nulo en un horario anterior. Se valida al leer
  /// (`isScheduleScore`): un JSON que no tenga esa forma se lee como nulo.
  score          Json?
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy      User                 @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  confirmedBy    User?                @relation("ScheduleConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  entries        ScheduleEntry[]
  generations    ScheduleGeneration[]

  @@index([schoolId])
  @@map("schedules")
}

/// Una sesión colocada en un horario: la clase, la asignatura, el profesor y la celda (día, número de sesión y horas
/// copiadas del calendario, para que el borrador no cambie si después se edita). `professor_id` queda nulo si se borra
/// el profesor. La clave única `schedule_entries_cell_key` es HC5 (una asignatura por clase y hueco); no hay una por
/// profesor porque HC2 es por intervalos y lo garantiza el validador. La clave ajena compuesta `(class_id, course_id)`
/// garantiza que la clase es del curso. Cinco `CHECK` escritos a mano en la migración: `_day_of_week_check` (1 a 5),
/// `_session_number_check` (1 a 8), `_start_minute_check` (>= 0), `_end_minute_check` (<= 1440) y `_range_check` (inicio
/// menor que fin).
model ScheduleEntry {
  /// UUIDv7 generado por la aplicación.
  id            String      @id @db.Uuid
  scheduleId    String      @map("schedule_id") @db.Uuid
  courseId      String      @map("course_id") @db.Uuid
  classId       String      @map("class_id") @db.Uuid
  subjectId     String      @map("subject_id") @db.Uuid
  professorId   String?     @map("professor_id") @db.Uuid
  /// De 1 (lunes) a 5 (viernes).
  dayOfWeek     Int         @map("day_of_week") @db.SmallInt
  sessionNumber Int         @map("session_number") @db.SmallInt
  /// Minutos desde las 00:00; la sesión es `[startMinute, endMinute)`.
  startMinute   Int         @map("start_minute") @db.SmallInt
  endMinute     Int         @map("end_minute") @db.SmallInt
  schedule      Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  schoolClass   SchoolClass @relation(fields: [classId, courseId], references: [id, courseId], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  professor     Professor?  @relation(fields: [professorId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, classId, dayOfWeek, sessionNumber], map: "schedule_entries_cell_key")
  @@index([classId])
  @@index([subjectId])
  @@index([professorId])
  @@map("schedule_entries")
}

/// Una ejecución del generador de horarios (US-ALGO-RUN): la fila es la cola y el estado que consulta la pantalla.
/// Solo puede haber una en curso por colegio (índice único parcial `schedule_generations_in_progress_key` sobre
/// `school_id` donde `status IN ('QUEUED','RUNNING')`, escrito a mano). `heartbeat_at` detecta las atascadas;
/// `cancel_requested` es la señal de cancelación que lee el worker. Un `CHECK` escrito a mano
/// (`schedule_generations_progress_check`) exige `placed` y `total` >= 0.
model ScheduleGeneration {
  /// UUIDv7 generado por la aplicación.
  id              String               @id @db.Uuid
  schoolId        String               @map("school_id") @db.Uuid
  createdById     String               @map("created_by_id") @db.Uuid
  status          GenerationStatus     @default(QUEUED)
  /// Sesiones colocadas (el máximo alcanzado) y sesiones que hay que colocar.
  placed          Int                  @default(0)
  total           Int                  @default(0)
  /// Si se pidió mejorar el horario con las preferencias (US-ALGO-RUN_b). Las filas anteriores lo tienen activado.
  improve         Boolean              @default(true)
  /// En qué fase está el worker. Empieza en `SEARCHING` y no vuelve atrás.
  phase           GenerationPhase      @default(SEARCHING)
  /// El motor que busca el horario, o que lo encontró (US-ALGO-ORTOOLS). Se fija al crearla con el motor configurado
  /// y pasa a `BACKTRACKING` si OR-Tools falla y se usa el otro. Las filas anteriores son `BACKTRACKING`.
  engine          ScheduleEngine       @default(BACKTRACKING)
  /// Puntuación del mejor horario hasta ahora (la del borrador guardado al terminar); mismo JSON que `schedules.score`.
  score           Json?
  errorCode       GenerationErrorCode? @map("error_code")
  errorMessage    String?              @map("error_message") @db.VarChar(500)
  /// Detalle estructurado del error (el motivo y la lección de `INFEASIBLE`).
  errorDetails    Json?                @map("error_details")
  /// El borrador guardado; nulo si no terminó bien o si el horario se borró.
  scheduleId      String?              @map("schedule_id") @db.Uuid
  heartbeatAt     DateTime?            @map("heartbeat_at") @db.Timestamptz()
  cancelRequested Boolean              @default(false) @map("cancel_requested")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  startedAt       DateTime?            @map("started_at") @db.Timestamptz()
  finishedAt      DateTime?            @map("finished_at") @db.Timestamptz()
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation(fields: [createdById], references: [id])
  schedule        Schedule?            @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([scheduleId])
  @@map("schedule_generations")
}
