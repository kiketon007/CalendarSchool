// Esquema Prisma de CalendarSchool. Se construye de forma incremental: cada historia
// añade aquí sus modelos (US01_b: municipios, colegios y usuarios; US01_c: refresh tokens; US01_d: intentos del limitador;
// US02_b3: enlaces de acceso; US-BASE: calendarios) y actualiza docs/Modelo_de_Datos/MODELO_DATOS.md.
// La URL de conexión no va aquí: la define prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/prisma/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Para qué sirve un enlace de acceso: invitar a una persona al colegio o restablecer una contraseña.
enum AccessLinkPurpose {
  INVITATION
  PASSWORD_RESET
}

/// Tipo de un periodo de la jornada (US-BASE): una sesión lectiva o un recreo.
enum CalendarPeriodKind {
  SESSION
  BREAK
}

/// Tipo de una regla de reparto de una asignatura en un curso (US19_b). Esta historia solo escribe
/// `MAX_PER_DAY` y `BLOCK`; los tipos de franjas los usarán US19_c y US19_d.
enum ConstraintType {
  MAX_PER_DAY
  BLOCK
  FORBIDDEN_SLOTS
  PREFERRED_SLOTS
}

/// Tipo de una asignatura (US-SUBJECT): troncal, optativa o propia del centro.
enum SubjectType {
  CORE
  ELECTIVE
  CUSTOM
}

/// Estado de una asignatura (US-SUBJECT). Por ahora solo se guarda y se filtra: sus consecuencias (no
/// ofrecerla al asignar profesores ni al generar horarios) llegan con esas historias.
enum SubjectStatus {
  ACTIVE
  INACTIVE
}

/// Color de una asignatura en el horario (US-SUBJECT): una paleta cerrada de 12 claves. El aspecto de cada
/// clave (fondo y texto, con contraste AA) vive en el frontend. Ampliar la paleta exige una migración.
enum SubjectColor {
  blue
  indigo
  purple
  pink
  red
  orange
  yellow
  green
  teal
  cyan
  brown
  gray
}

/// Cargo de un profesor (US09). Es informativo y no concede permisos en la aplicación.
enum ProfessorPosition {
  DIRECTOR
  JEFE_ESTUDIOS
}

/// Municipios de la Comunitat Valenciana (relación oficial del INE). Datos fijos cargados por migración.
model Municipality {
  /// Código INE: 2 dígitos de provincia y 3 de municipio.
  code     String   @id @db.Char(5)
  /// Nombre oficial, que puede tener dos formas (p. ej. "Alicante/Alacant").
  name     String   @db.VarChar(100)
  province String   @db.VarChar(30)
  schools  School[]

  @@index([name])
  @@map("municipalities")
}

/// Colegios. Cada colegio aísla sus datos de los de los demás.
model School {
  /// UUIDv7 generado por la aplicación.
  id                    String                 @id @db.Uuid
  /// Nombre tal como lo escribe el usuario.
  name                  String                 @db.VarChar(150)
  /// Nombre en minúsculas, sin acentos y solo con letras y dígitos; sirve para la unicidad.
  normalizedName        String                 @map("normalized_name") @db.VarChar(150)
  municipalityCode      String                 @map("municipality_code") @db.Char(5)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz()
  municipality          Municipality           @relation(fields: [municipalityCode], references: [code])
  users                 User[]
  accessLinks           AccessLink[]
  courses               Course[]
  professors            Professor[]
  students              Student[]
  calendars             Calendar[]
  subjects              Subject[]
  schedulingConstraints SchedulingConstraint[]

  @@unique([normalizedName, municipalityCode])
  @@map("schools")
}

/// Usuarios con cuenta. Cada usuario pertenece a un único colegio.
model User {
  /// UUIDv7 generado por la aplicación.
  id                      String         @id @db.Uuid
  schoolId                String         @map("school_id") @db.Uuid
  /// Email normalizado (sin espacios y en minúsculas), único en todo el sistema.
  email                   String         @unique @db.VarChar(320)
  /// Hash Bcrypt (cost 12).
  passwordHash            String         @map("password_hash") @db.VarChar(60)
  firstName               String         @map("first_name") @db.VarChar(100)
  lastName                String         @map("last_name") @db.VarChar(100)
  role                    UserRole
  status                  UserStatus     @default(ACTIVE)
  /// Instante en que se aceptó la política de privacidad. Va con `privacyPolicyVersion`: las dos o ninguna (CHECK en la migración).
  privacyPolicyAcceptedAt DateTime?      @map("privacy_policy_accepted_at") @db.Timestamptz()
  /// Versión (AAAA-MM-DD) de la política aceptada.
  privacyPolicyVersion    String?        @map("privacy_policy_version") @db.VarChar(20)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  school                  School         @relation(fields: [schoolId], references: [id])
  refreshTokens           RefreshToken[]
  /// Enlaces de acceso que afectan a este usuario (restablecimientos de contraseña).
  accessLinks             AccessLink[]   @relation("AccessLinkUser")
  /// Enlaces de acceso que este usuario generó.
  createdAccessLinks      AccessLink[]   @relation("AccessLinkCreator")

  @@index([schoolId])
  @@map("users")
}

/// Refresh tokens de las sesiones. Solo se guarda el hash del token, nunca el token en claro.
/// Sesión de un usuario. No guarda la IP ni el user agent del cliente: ninguna funcionalidad los usa y
/// solo quedan en los logs de actividad (30 días).
model RefreshToken {
  /// UUIDv7 generado por la aplicación.
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 del token en hexadecimal.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Creación + 24 horas. La sesión no se renueva: es una caducidad absoluta.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  /// Instante de la revocación (cierre de sesión, US03); nulo mientras el token es válido.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Intentos de operaciones limitadas (registro, y más adelante login e invitaciones). Una fila por intento
/// aceptado: el limitador cuenta las de una clave dentro de la ventana y borra las caducadas.
model RateLimitAttempt {
  /// UUIDv7 generado por la aplicación.
  id          String   @id @db.Uuid
  /// `<operación>:<ip>`, p. ej. `register:203.0.113.7`.
  key         String   @db.VarChar(200)
  attemptedAt DateTime @map("attempted_at") @db.Timestamptz()

  @@index([key, attemptedAt])
  @@map("rate_limit_attempts")
}

/// Enlaces de acceso de un solo uso que genera un administrador: invitaciones (US02_b) y restablecimientos
/// de contraseña (US02_c). Solo se guarda el hash del token; el enlace completo se muestra una vez.
/// Un `CHECK` (`access_links_purpose_fields_check`: `role` solo en invitaciones y `user_id` solo en
/// restablecimientos) y el índice único parcial `access_links_pending_reset_user_key` (un solo
/// restablecimiento pendiente por usuario) están escritos a mano en la migración: Prisma no los modela.
model AccessLink {
  /// UUIDv7 generado por la aplicación.
  id          String            @id @db.Uuid
  schoolId    String            @map("school_id") @db.Uuid
  purpose     AccessLinkPurpose
  /// SHA-256 del token en hexadecimal. Nunca el token.
  tokenHash   String            @unique @map("token_hash") @db.Char(64)
  /// Rol del invitado. Obligatorio en las invitaciones y nulo en los restablecimientos.
  role        UserRole?
  /// Usuario afectado. Obligatorio en los restablecimientos y nulo en las invitaciones.
  userId      String?           @map("user_id") @db.Uuid
  /// Administrador que generó el enlace.
  createdById String            @map("created_by_id") @db.Uuid
  /// Creación + 72 horas.
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz()
  usedAt      DateTime?         @map("used_at") @db.Timestamptz()
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz()
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  school      School            @relation(fields: [schoolId], references: [id])
  user        User?             @relation("AccessLinkUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("AccessLinkCreator", fields: [createdById], references: [id])

  @@index([schoolId, purpose])
  @@map("access_links")
}

/// Cursos de un colegio (US05). Su nombre es único en el colegio sin distinguir mayúsculas ni espacios.
model Course {
  /// UUIDv7 generado por la aplicación.
  id             String          @id @db.Uuid
  schoolId       String          @map("school_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name           String          @db.VarChar(100)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad.
  normalizedName String          @map("normalized_name") @db.VarChar(100)
  /// Calendario base que sigue el curso (US-BASE), como mucho uno; si se borra el calendario queda nulo.
  calendarId     String?         @map("calendar_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  school         School          @relation(fields: [schoolId], references: [id])
  calendar       Calendar?       @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  classes        SchoolClass[]
  students       Student[]
  /// Asignaturas que se imparten en este curso; se borran con él (la asignatura sigue existiendo).
  subjects       SubjectCourse[]

  @@unique([schoolId, normalizedName])
  @@index([calendarId])
  @@map("courses")
}

/// Profesores de un colegio (US09). Un registro del colegio, no una cuenta. Las asignaturas llegan con
/// `US-PROF-ASSIGN`; el nombre no es único: puede haber varios profesores con el mismo.
model Professor {
  /// UUIDv7 generado por la aplicación.
  id           String             @id @db.Uuid
  schoolId     String             @map("school_id") @db.Uuid
  firstName    String             @map("first_name") @db.VarChar(100)
  lastName     String             @map("last_name") @db.VarChar(100)
  position     ProfessorPosition?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  school       School             @relation(fields: [schoolId], references: [id])
  /// La clase que tutoriza, si tutoriza alguna (como mucho una: `classes.tutor_id` es único).
  tutoredClass SchoolClass?

  @@index([schoolId])
  @@map("professors")
}

/// Clases (grupos A, B…) de un curso. Se borran con su curso. Su tutor es opcional y, si lo borran, la
/// clase se queda sin tutor (`ON DELETE SET NULL`); un profesor tutoriza como mucho una clase (US09).
model SchoolClass {
  /// UUIDv7 generado por la aplicación.
  id             String     @id @db.Uuid
  courseId       String     @map("course_id") @db.Uuid
  /// Profesor que tutoriza la clase; único: un profesor tutoriza como mucho una clase.
  tutorId        String?    @unique @map("tutor_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name           String     @db.VarChar(10)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad en el curso.
  normalizedName String     @map("normalized_name") @db.VarChar(10)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor          Professor? @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  students       Student[]

  @@unique([courseId, normalizedName])
  @@map("classes")
}

/// Alumnos de un colegio (US14). El curso es obligatorio al crear, pero si se borra el curso el alumno
/// sigue existiendo sin curso ni clase (`ON DELETE SET NULL`); quitar solo la clase lo deja en su curso.
/// `food_type` y `observations` son datos sensibles (posibles datos de salud): nunca van a logs ni al
/// listado. Dos `CHECK` escritos a mano en la migración: sin comedor no hay beca ni tipo de comida, y con
/// comedor la beca siempre tiene respuesta. Revisa el SQL de cada `prisma migrate dev` posterior.
model Student {
  /// UUIDv7 generado por la aplicación.
  id           String       @id @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  courseId     String?      @map("course_id") @db.Uuid
  classId      String?      @map("class_id") @db.Uuid
  firstName    String       @map("first_name") @db.VarChar(100)
  lastName     String       @map("last_name") @db.VarChar(100)
  /// Si come en el comedor.
  cafeteria    Boolean
  /// Beca de comedor: nulo si no come en el comedor.
  scholarship  Boolean?
  /// Tipo de comida (dato sensible): nulo si no come en el comedor o no se indicó.
  foodType     String?      @map("food_type") @db.VarChar(255)
  /// Observaciones (dato sensible), hasta 5000 caracteres que limita la aplicación.
  observations String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  school       School       @relation(fields: [schoolId], references: [id])
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  schoolClass  SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([courseId])
  @@index([classId])
  @@map("students")
}

/// Calendarios base del horario de un colegio (US-BASE): una estructura de jornada (p. ej. «Primaria» o
/// «Infantil») igual de lunes a viernes. Su nombre es único en el colegio sin distinguir mayúsculas ni espacios.
model Calendar {
  /// UUIDv7 generado por la aplicación.
  id             String           @id @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name           String           @db.VarChar(100)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad.
  normalizedName String           @map("normalized_name") @db.VarChar(100)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  school         School           @relation(fields: [schoolId], references: [id])
  periods        CalendarPeriod[]
  /// Cursos que siguen este calendario.
  courses        Course[]

  @@unique([schoolId, normalizedName])
  @@map("calendars")
}

/// Un periodo de la jornada de un calendario (US-BASE): una sesión o un recreo. El orden del día es
/// `position`; el número de una sesión no se guarda: es su orden entre las sesiones. Las horas son minutos
/// desde las 00:00 (evita las zonas horarias de `TIME` con Prisma). Un `CHECK` escrito a mano en la migración
/// exige `0 <= start_minute < end_minute <= 1439`: revisa el SQL de cada `prisma migrate dev` posterior.
model CalendarPeriod {
  /// UUIDv7 generado por la aplicación.
  id          String             @id @db.Uuid
  calendarId  String             @map("calendar_id") @db.Uuid
  position    Int                @db.SmallInt
  kind        CalendarPeriodKind
  startMinute Int                @map("start_minute") @db.SmallInt
  endMinute   Int                @map("end_minute") @db.SmallInt
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  calendar    Calendar           @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, position])
  @@map("calendar_periods")
}

/// Asignaturas de un colegio (US-SUBJECT). El nombre es único en el colegio sin distinguir mayúsculas ni
/// espacios; el código, opcional, también (sin distinguir mayúsculas). PostgreSQL trata los `NULL` como
/// distintos en un índice único, así que varias asignaturas sin código no chocan. El color es la clave de
/// una paleta cerrada y puede repetirse entre asignaturas.
model Subject {
  /// UUIDv7 generado por la aplicación.
  id             String          @id @db.Uuid
  schoolId       String          @map("school_id") @db.Uuid
  /// Nombre tal como se muestra: recortado y con los espacios colapsados.
  name           String          @db.VarChar(100)
  /// Nombre en minúsculas, recortado y con los espacios colapsados; sirve para la unicidad.
  normalizedName String          @map("normalized_name") @db.VarChar(100)
  /// Código corto tal como se escribió, o nulo si no tiene (nunca una cadena vacía).
  code           String?         @db.VarChar(10)
  /// Código en minúsculas; sirve para la unicidad. Nulo cuando `code` es nulo.
  normalizedCode String?         @map("normalized_code") @db.VarChar(10)
  type           SubjectType
  status         SubjectStatus
  /// Descripción opcional (hasta 500 caracteres); nula si está vacía.
  description    String?         @db.VarChar(500)
  color          SubjectColor
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  school         School          @relation(fields: [schoolId], references: [id])
  /// Cursos en los que se imparte. Puede quedar vacía si se borran todos sus cursos.
  courses        SubjectCourse[]

  @@unique([schoolId, normalizedName])
  @@unique([schoolId, normalizedCode])
  @@map("subjects")
}

/// Curso en el que se imparte una asignatura y sesiones semanales que lleva en él (US-SUBJECT). La clave
/// primaria es la pareja. Se borra con la asignatura y con el curso. Sus reglas de reparto cuelgan de la
/// pareja con una clave ajena compuesta en cascada: por eso la edición de asignaturas aplica diferencias en
/// lugar de reemplazar las filas, o borraría las reglas en cada guardado. Un `CHECK` escrito a mano en la migración exige `sessions_per_week` de 1 a 5:
/// revisa el SQL de cada `prisma migrate dev` posterior.
model SubjectCourse {
  subjectId       String                 @map("subject_id") @db.Uuid
  courseId        String                 @map("course_id") @db.Uuid
  sessionsPerWeek Int                    @map("sessions_per_week") @db.SmallInt
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz()
  subject         Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  constraints     SchedulingConstraint[]

  @@id([subjectId, courseId])
  @@index([courseId])
  @@map("subject_courses")
}

/// Regla de reparto de una asignatura en un curso (US19_b): una fila por (asignatura, curso, tipo). Cuelga de
/// la pareja de `subject_courses` con una clave ajena compuesta en cascada: dejar de impartir la asignatura
/// en el curso, borrar la asignatura o borrar el curso borra sus reglas. `max_per_day` (2 a 5) solo vale
/// en `MAX_PER_DAY` y `block_size` (2 o 3) solo en `BLOCK`. Tres `CHECK` escritos a mano en la migración
/// (`scheduling_constraints_max_per_day_check`, `_block_check` y `_slots_check`) lo exigen: revisa el SQL
/// de cada `prisma migrate dev` posterior.
model SchedulingConstraint {
  id            String         @id @db.Uuid
  schoolId      String         @map("school_id") @db.Uuid
  subjectId     String         @map("subject_id") @db.Uuid
  courseId      String         @map("course_id") @db.Uuid
  type          ConstraintType
  /// Sesiones sueltas máximas al día (2 a 5); solo en `MAX_PER_DAY`.
  maxPerDay     Int?           @map("max_per_day") @db.SmallInt
  /// Tamaño del bloque de sesiones seguidas (2 o 3); solo en `BLOCK`.
  blockSize     Int?           @map("block_size") @db.SmallInt
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  school        School         @relation(fields: [schoolId], references: [id])
  subjectCourse SubjectCourse  @relation(fields: [subjectId, courseId], references: [subjectId, courseId], onDelete: Cascade)

  @@unique([subjectId, courseId, type])
  @@index([courseId])
  @@index([schoolId])
  @@map("scheduling_constraints")
}
