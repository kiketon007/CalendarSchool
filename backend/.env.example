# Plantilla de variables de entorno del backend. Cópiala a `backend/.env` (nunca se versiona).
# Las credenciales son solo de desarrollo local y coinciden con docker-compose.yml.

# Entorno de ejecución: development | test | production
NODE_ENV=development
# Puerto HTTP del backend de desarrollo
PORT=3000
# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Base de datos de desarrollo
DATABASE_URL=postgresql://calendarschool:calendarschool@localhost:5432/calendarschool

# Base de datos de test: solo la usan los tests de integración y el E2E (la app no la lee)
TEST_DATABASE_URL=postgresql://calendarschool:calendarschool@localhost:5432/calendarschool_test
